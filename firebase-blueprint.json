{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User background wallpapers and preferences",
      "type": "object",
      "properties": {
        "customWallpapers": { "type": "string" },
        "selectedWallpaperId": { "type": "string", "maxLength": 128 },
        "deletedWallpaperIds": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["updatedAt"]
    },
    "TabError": {
      "title": "TabError",
      "description": "Error and bug reports submitted for tabs or system features",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tabId": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 64, "enum": ["UI/Layout", "Performance", "Data/Logic", "Crash/Freeze", "Audio/Video", "Responsive/Mobile", "Other"] },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["open", "investigating", "resolved", "pending", "in_progress", "fixed"] },
        "deviceInfo": { "type": "string", "maxLength": 500 },
        "reporterEmail": { "type": "string", "maxLength": 256 },
        "reporterName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "syncedOffline": { "type": "boolean" }
      },
      "required": ["tabId", "title", "description", "category", "severity", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "users/{userId}/preferences/{prefId}": {
      "schema": "UserPreferences",
      "description": "User preferences and wallpaper storage"
    },
    "tabErrors/{errorId}": {
      "schema": "TabError",
      "description": "Reported errors and bugs across application tabs"
    }
  }
}
